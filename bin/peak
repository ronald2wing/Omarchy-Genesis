#!/bin/bash

# Print the current peak amplitude (0.0–1.0) of the recording WAV, so the
# overlay can show a live level meter while listening. Reads the last ~100ms
# of 16 kHz mono s16 PCM from the file `capture` is still writing.
#
# Usage: peak <recording.wav>

wav="${1:-}"
[[ -n $wav && -f $wav ]] || { echo 0; exit 0; }

size=$(stat -c %s "$wav" 2>/dev/null || echo 0)
# 44-byte WAV header + a little data before there's anything to measure.
[[ $size -gt 4000 ]] || { echo 0; exit 0; }

tail -c 3200 "$wav" | od -An -v -t d2 | awk '
  { for (i = 1; i <= NF; i++) { v = $i; if (v < 0) v = -v; if (v > m) m = v } }
  END { printf "%.3f\n", (m / 32767) }
'
