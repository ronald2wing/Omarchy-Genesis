#!/bin/bash

# One-time setup for the Genesis wake-word listener: create a dedicated venv,
# install openWakeWord + onnxruntime + sounddevice, and download the configured
# (or default) wake-word model. Safe to re-run.

set -euo pipefail

PLUGIN_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$PLUGIN_BIN_DIR/lib.sh"

VENV="$WAKE_WORD_VENV"
model=$(config_get wakeWord.model "hey_jarvis")
# Only a shipped model name may be interpolated into the python call below.
[[ $model =~ ^[A-Za-z0-9_-]+$ ]] || { echo "wake-word-setup: invalid model name '$model'" >&2; exit 1; }

have python3 || { echo "wake-word-setup: python3 is required" >&2; exit 1; }

python3 -m venv "$VENV"
"$VENV/bin/pip" install --quiet --upgrade pip
"$VENV/bin/pip" install --quiet openwakeword onnxruntime sounddevice
"$VENV/bin/python" -c "import openwakeword; openwakeword.utils.download_models(model_names=['$model'])"

echo "Wake-word setup complete. Start it with: bin/wake-word start"
